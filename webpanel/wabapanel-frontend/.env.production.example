# ===== Codiic Panel — Production (Next.js frontend) =====
# Copy before build on the server:
#   cp .env.production.example .env.production
# Then: npm run build && npm run start (or PM2)
#
# App URL:  https://crm-360.codiic.com
# API URL:  https://crm-backend.codiic.com

NODE_ENV=production
PORT=3002

# Public site URL (SEO, OG tags, sitemap, canonical links)
NEXT_PUBLIC_SITE_URL=https://crm-360.codiic.com

# Browser calls the API on the backend subdomain
NEXT_PUBLIC_API_URL=https://crm-backend.codiic.com/api
NEXT_PUBLIC_SOCKET_URL=https://crm-backend.codiic.com

# SSR/branding fetches hit local Express (avoid hairpin through public DNS)
# If frontend and API are on different servers, use:
# INTERNAL_API_URL=https://crm-backend.codiic.com/api
INTERNAL_API_URL=http://127.0.0.1:5000/api

# Informatic storefront host (prod)
# Dev equivalent: http://{sub}.localhost:3003
NEXT_PUBLIC_STOREFRONT_PROTOCOL=https
NEXT_PUBLIC_STOREFRONT_HOST_SUFFIX=.crm-360.codiic.com
