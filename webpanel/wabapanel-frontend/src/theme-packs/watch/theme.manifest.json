{
  "id": "watch",
  "name": "Watch",
  "version": "0.1.0",
  "type": "react-remote",
  "configMode": "sections",
  "assets": {
    "themeJs": "theme.js",
    "themeCss": "theme.css",
    "defaultConfig": "theme.default-config.json",
    "schema": "theme.schema.json"
  },
  "templates": [
    "index",
    "product",
    "search",
    "collections_list",
    "all_products",
    "404",
    "collection",
    "all_blogs",
    "blogs",
    "blog_posts",
    "cart",
    "login",
    "signup",
    "forgot_password",
    "profile",
    "orders",
    "order_details"
  ],
  "capabilities": {
    "sections": true,
    "blocks": true,
    "globalSettings": true,
    "livePreview": true
  },
  "blockTypes": {
    "basic": [
      {
        "id": "announcement",
        "label": "Announcement"
      },
      {
        "id": "logo",
        "label": "Logo"
      },
      {
        "id": "brand",
        "label": "Brand"
      },
      {
        "id": "menu",
        "label": "Menu"
      },
      {
        "id": "faq-item",
        "label": "Question"
      }
    ]
  },
  "sectionBlocks": {
    "announcement-bar": [
      "announcement"
    ],
    "header": [
      "logo",
      "menu"
    ],
    "footer": [
      "brand",
      "menu"
    ],
    "product-faq": [
      "faq-item"
    ]
  }
}
