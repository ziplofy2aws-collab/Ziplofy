{
  "id": "informatic",
  "name": "Informatic",
  "version": "0.1.0",
  "type": "react-remote",
  "configMode": "sections",
  "category": "informatic",
  "description": "Content / information site theme — marketing pages, blog, contact. No commerce templates.",
  "assets": {
    "themeJs": "theme.js",
    "themeCss": "theme.css",
    "defaultConfig": "theme.default-config.json",
    "schema": "theme.schema.json"
  },
  "templates": [
    "index",
    "about",
    "features",
    "pricing",
    "blog_list",
    "blog_post",
    "page",
    "contact",
    "faq",
    "privacy",
    "terms",
    "return_refund",
    "contact_info",
    "404",
    "search"
  ],
  "capabilities": {
    "sections": true,
    "blocks": true,
    "globalSettings": true,
    "livePreview": true,
    "commerce": false,
    "informatic": true
  },
  "blockTypes": {
    "basic": [
      { "id": "announcement", "label": "Announcement" },
      { "id": "logo", "label": "Logo" },
      { "id": "brand", "label": "Brand" },
      { "id": "menu", "label": "Menu" },
      { "id": "social", "label": "Social links" },
      { "id": "faq-item", "label": "Question" },
      { "id": "feature-item", "label": "Feature" },
      { "id": "pricing-plan", "label": "Plan" },
      { "id": "testimonial", "label": "Testimonial" },
      { "id": "logo-item", "label": "Logo item" },
      { "id": "stat-item", "label": "Stat" },
      { "id": "gallery-item", "label": "Gallery item" }
    ]
  },
  "sectionBlocks": {
    "announcement-bar": ["announcement"],
    "header": ["logo", "menu"],
    "footer": ["brand", "menu", "legal", "social"],
    "faq": ["faq-item"],
    "features-grid": ["feature-item"],
    "pricing": ["pricing-plan"],
    "testimonials": ["testimonial"],
    "logo-cloud": ["logo-item"],
    "stats-band": ["stat-item"],
    "media-gallery": ["gallery-item"]
  }
}
