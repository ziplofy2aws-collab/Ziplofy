# ===== Codiic Panel — Production (Express API) =====
# Place at: wabapanel-express/.env.production
#
# Frontend: https://crm-360.codiic.com
# Backend:  https://crm-backend.codiic.com

NODE_ENV=production
PORT=5000

MONGODB_URI=mongodb://localhost:27017/wabapanel

JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE=7d
JWT_EXPIRES_IN=7d
SESSION_SECRET=change_me_to_a_long_random_string

FRONTEND_URL=https://crm-360.codiic.com
BACKEND_URL=https://crm-backend.codiic.com
API_URL=https://crm-backend.codiic.com
ADMIN_URL=https://crm-360.codiic.com
COOKIE_DOMAIN=
CORS_ORIGINS=https://crm-360.codiic.com

WHATSAPP_VERIFY_TOKEN=change_me
PANEL_VERSION=codiic-production

# Google Sign-In (OAuth 2.0 Web client ID)
GOOGLE_CLIENT_ID=

# AWS S3 — store media library
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
