# SSL worker environment — place at /home/ubuntu/Ziplofy/webpanel/wabapanel-express/.env.production
# on the gateway (shared with the main API env file where values overlap).

# Same Atlas DB as wabapanel-express (the `wabapanel` database).
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/<wabapanel>?retryWrites=true&w=majority

# Public IP customer domains must resolve to — this gateway.
SSL_GATEWAY_PUBLIC_IP=3.107.46.222

# Let's Encrypt registration email (expiry notices).
LETSENCRYPT_EMAIL=ops@codiic.com

# true → LE staging CA (fake certs, unlimited issuance — use while testing).
# false → production CA (rate-limited — only after staging verification).
CERTBOT_STAGING=true

# Paths — defaults are fine for a standard Ubuntu nginx+certbot box.
ACME_WEBROOT=/var/www/letsencrypt
NGINX_DOMAIN_CONF_DIR=/etc/nginx/conf.d/domains
NGINX_BIN=nginx
NGINX_RELOAD_CMD=systemctl reload nginx
CERTBOT_BIN=certbot
OPENSSL_BIN=openssl

# Storefront static root + API upstream (mirror the wildcard vhost).
STOREFRONT_RENDERER_ROOT=/var/www/webpanel-store-renderer
STOREFRONT_API_UPSTREAM=https://crm-backend.codiic.com
STOREFRONT_API_HOST_HEADER=crm-backend.codiic.com

# Worker tuning (defaults shown).
# SSL_POLL_CRON=*/1 * * * *
# SSL_RECONCILE_CRON=*/15 * * * *
# SSL_EXPIRY_SCAN_CRON=17 3 * * *
# SSL_LOCK_TTL_MS=600000
# SSL_MAX_ATTEMPTS=8
# SSL_BACKOFF_BASE_MS=300000
# SSL_BACKOFF_CAP_MS=21600000
