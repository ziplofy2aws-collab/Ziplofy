{
  "version": "1.0.0",
  "themeId": "watch",
  "description": "Watch \u2014 luxury watches storefront (nav-first rebuild).",
  "schemaVersion": "2.0.0",
  "globalSettings": {
    "label": "Theme settings",
    "settings": {
      "colors": {
        "type": "group",
        "label": "Colors",
        "settings": {
          "primary": {
            "type": "color",
            "label": "Primary",
            "default": "#c5a059"
          },
          "background": {
            "type": "color",
            "label": "Background",
            "default": "#ffffff"
          },
          "text": {
            "type": "color",
            "label": "Text",
            "default": "#111111"
          },
          "surface": {
            "type": "color",
            "label": "Surface",
            "default": "#ffffff"
          },
          "muted": {
            "type": "color",
            "label": "Muted",
            "default": "#6b6b6b"
          }
        }
      },
      "typography": {
        "type": "group",
        "label": "Typography",
        "settings": {
          "fontFamily": {
            "type": "text",
            "label": "Heading font",
            "default": "\"Cormorant Garamond\", Georgia, serif"
          },
          "fontFamilyBody": {
            "type": "text",
            "label": "Body font",
            "default": "\"Montserrat\", system-ui, sans-serif"
          }
        }
      }
    }
  },
  "layout": {
    "announcement_bar": {
      "label": "Announcement bar",
      "description": "Storewide announcement message",
      "settingsFields": [
        {
          "path": "sections.announcement_bar.settings.enabled",
