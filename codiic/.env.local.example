# Copy to `.env.local` and restart `npm run dev`
# Production values: see `.env.production.example`

# ── Static catalog theme editor (local Watch, no S3) ─────────────────────────
# When true:
#   • Themes page (/online-store/themes) shows "Open catalog editor"
#   • Opens /themes/dev-editor with the Watch pack
#   • Loads schema + theme.js/css from remote-themes/watch (via Vite middleware)
VITE_STATIC_CATALOG_THEME_EDITOR_MODE=true

# Pack id: watch | horizon (defaults to watch when catalog static mode is on)
VITE_THEME_EDITOR_STATIC_PACK=watch

# Optional overrides (defaults already point at /remote-themes/watch):
# VITE_THEME_EDITOR_STATIC_BASE_URL=/remote-themes/watch
# VITE_THEME_EDITOR_STATIC_JS_URL=/remote-themes/watch/theme.js
# VITE_THEME_EDITOR_STATIC_CSS_URL=/remote-themes/watch/theme.css
# VITE_THEME_EDITOR_STATIC_STORE_ID=<your-mongodb-store-id>

# Alias of VITE_STATIC_CATALOG_THEME_EDITOR_MODE:
# VITE_THEME_EDITOR_STATIC_MODE=true

# After editing Watch theme source:
#   cd remote-themes/watch && npm run build
# Then refresh the catalog editor (no S3 upload needed).

# Preview iframe (render-store on :5180):
# VITE_RENDER_STORE_ORIGIN=http://localhost:5180
