# Production build for render-store (merchant storefronts + preview.codiic.com)
#
# Leave VITE_API_URL unset for merchant *.codiic.com hosts — nginx proxies /api on the same origin.
# For local dev, use VITE_PROXY_TARGET=http://127.0.0.1:5000 in vite.config / shell env.

# Optional — only if API is on a different host than the storefront:
# VITE_API_URL=https://backend.codiic.com

# Optional — public asset origin override (defaults to window.location.origin):
# VITE_STOREFRONT_ORIGIN=https://preview.codiic.com
